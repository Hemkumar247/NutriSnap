## API Route Pattern (always use this exact structure)

```typescript
// app/api/[endpoint]/route.ts
import { NextRequest, NextResponse } from 'next/server';
import { requireAuth } from '@/lib/authMiddleware';
import { checkRateLimit } from '@/lib/rateLimiter';

export async function POST(request: NextRequest) {
  try {
    const { userId } = await requireAuth(request);
    
    const { allowed, remaining } = await checkRateLimit(userId);
    if (!allowed) {
      return NextResponse.json(
        { error: 'Rate limit exceeded. Try again in the next hour.' },
        { status: 429 }
      );
    }
    
    const body = await request.json();
    // validate body here
    
    // call geminiServer function here
    
    return NextResponse.json(result, { status: 200 });
    
  } catch (error) {
    console.error('[/api/endpoint]', error);
    return NextResponse.json(
      { error: 'Something went wrong. Please try again.' },
      { status: 500 }
    );
  }
}
```

## dbService Pattern (always use this exact structure)

```typescript
// services/dbService.ts
import { createClient } from '@/lib/supabase/client';

export async function getTodayLog(userId: string): Promise<DailyLogItem[]> {
  const supabase = createClient();
  const today = new Date().toISOString().split('T')[0];
  
  const { data, error } = await supabase
    .from('food_logs')
    .select('*')
    .eq('user_id', userId)
    .eq('meal_date', today)
    .order('logged_at', { ascending: false });
  
  if (error) throw new Error(`getTodayLog failed: ${error.message}`);
  return (data ?? []).map(mapDbRowToDailyLogItem);
}
```

## Component Update Pattern

When updating existing components to use DB instead of localStorage:

```typescript
// BEFORE (old localStorage pattern — remove this)
useEffect(() => {
  const saved = localStorage.getItem('nutrisnap_log');
  if (saved) setDailyLog(JSON.parse(saved));
}, []);

// AFTER (new DB pattern — use this)
useEffect(() => {
  if (!userId) return;
  dbService.getTodayLog(userId).then(setDailyLog).catch(console.error);
}, [userId]);
```

