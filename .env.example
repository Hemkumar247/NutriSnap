# Copy to `.env.local` and fill in values. Never commit `.env.local`.
# See technical-spec.md Section 6 (Environment Variables).

# Google AI / Gemini: create an API key in Google AI Studio (https://aistudio.google.com/apikey)
# or Google Cloud Console. Server-only — never expose to the client.
GEMINI_API_KEY=

# Supabase: Project Settings → API → Project URL (safe for browser + server).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase: Project Settings → API → Project API keys → anon / public key (RLS enforced).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase: Project Settings → API → Project API keys → service_role (secret). Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Full public origin of this app. Local dev: http://localhost:3000. Production: your Vercel URL
# (e.g. https://your-app.vercel.app). Used for OAuth redirect base: {this}/auth/callback.
NEXT_PUBLIC_APP_URL=
