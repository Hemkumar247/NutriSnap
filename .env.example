# NutriSnap - Firebase / Gemini Project Variables

# 1. Google Gemini API Key
# Generated in Google AI Studio: https://aistudio.google.com/apikey
# Server-only — never expose to your React components.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Firebase Client SDK (Settings -> General -> Your apps -> Web app)
# These are safe to expose to the client as they only identify your project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 3. Firebase Admin SDK (Settings -> Service accounts)
# These are server-only. Never expose to client-side files.
# FIREBASE_ADMIN_PRIVATE_KEY is the most sensitive secret.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 4. App URL Configuration
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
# Used for session cookie settings and redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
